# ---------------------------------------------------------------------------
# Meridian LMS environment configuration
# Copy to `.env` and adjust. See docs/getting-started.md for details.
# ---------------------------------------------------------------------------

# Database — SQLite for local development, Postgres in production, e.g.
#   postgresql://user:password@host:5432/meridian
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs (HS256). Generate with:
#   openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Session lifetime in hours (default 12).
SESSION_TTL_HOURS=12

# Public base URL of the deployment (used in emails).
APP_URL="http://localhost:3000"

# --- Zoom (Server-to-Server OAuth app) — optional --------------------------
# When unset, live classes fall back to "manual" mode where an admin pastes
# a meeting link. See docs/integrations/zoom.md.
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# --- SMTP email — optional --------------------------------------------------
# When unset, outgoing email is recorded in the Email Log with status
# SKIPPED instead of being sent. See docs/integrations/email.md.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Meridian LMS <no-reply@meridian.school>"
